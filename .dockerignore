node_modules
.next
.next-profiles
dist
coverage
playwright-report
test-results

# Never send local secrets or data into the build context.
.env
.env.*
!.env.example
data

.git
.github
.vscode
.idea
.DS_Store

*.log
npm-debug.log*
pnpm-debug.log*

# Docs and tests are not needed to build or run the image.
docs
tests
# Tests co-located next to the code they cover must be excluded by name as
# well. They are not shipped, but `next build` type checks everything in the
# context — and the import that registers their matcher types lives in
# tests/setup/, which the line above already excludes. Leaving them in fails
# the production build while a local `pnpm typecheck` still passes.
**/*.test.ts
**/*.test.tsx
*.md
!README.md

Dockerfile
Dockerfile.dev
compose.yaml
compose.dev.yaml
.dockerignore
