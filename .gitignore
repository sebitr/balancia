# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local data (receipt uploads, dev database)
/data

# generated service worker
public/sw.js
public/sw.js.map

# optional embedding model, installed by scripts/fetch-semantic-model.ts
public/models
public/pdfjs

# optional payment-method logos, supplied by the operator.
# The instructions stay in the repo; the artwork never does — see the README
# in that directory for why.
public/payment-methods/*
!public/payment-methods/README.md

# build output for worker/migrator bundles
/dist

# playwright
/playwright-report
/test-results

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent session worktrees — whole checkouts of this repository, which would
# otherwise show up as untracked files in the checkout that contains them
.claude/worktrees/
.worktree-install.log
.ocr-eval/

# the bare mirror the local Weblate clones from and pushes to, kept by
# scripts/weblate.sh — a scratch copy of origin/main, rebuilt on demand. The
# file .weblate, which names the public translation project, is tracked.
/.weblate-mirror/

# pnpm's content-addressable store, when it lands in the project rather than
# in the container volume. Both images set `store-dir /pnpm/store`, but pnpm
# run anywhere else puts its store on the same filesystem as the project it
# is installing into — which, under a bind mount, is right here. 42,755 of
# these files were committed once already, swept up by a `git add .`, and
# `format:check` went red on main until they were taken back out.
/.pnpm-store/
